generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Usuario {
  id                   String   @id @default(uuid()) @db.VarChar(36)
  nome                 String   @db.VarChar(100)
  email                String   @unique @db.VarChar(150)
  senhaHash            String   @db.VarChar(255)
  role                 String   @default("user") @db.VarChar(20)
  isPremium            Boolean  @default(false)
  stripeCustomerId     String?  @db.VarChar(255)
  stripeSubscriptionId String?  @db.VarChar(255)
  bio                  String?  @db.Text
  fotoPerfil           String?  @db.Text
  criadoEm             DateTime @default(now())

  refreshTokens        RefreshToken[]
  resetTokens          ResetToken[]
  favoritos            Favorito[]
  comentarios          Comentario[]
  listasPersonalizadas ListaPersonalizada[]
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique @db.VarChar(255)
  usuarioId String   @db.VarChar(36)
  expiresAt DateTime
  criadoEm  DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}

model ResetToken {
  token     String   @id @default(uuid()) @db.VarChar(36)
  usuarioId String   @db.VarChar(36)
  expiresAt DateTime
  criadoEm  DateTime @default(now())
  usado     Boolean  @default(false)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}

model Favorito {
  id          Int      @id @default(autoincrement())
  usuarioId   String   @db.VarChar(36)
  tmdbMovieId Int
  titulo      String   @db.VarChar(255)
  posterPath  String?  @db.VarChar(255)
  criadoEm    DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@unique([usuarioId, tmdbMovieId])
}

model Comentario {
  id          Int      @id @default(autoincrement())
  usuarioId   String   @db.VarChar(36)
  tmdbMovieId Int
  texto       String
  criadoEm    DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id])
}

model ListaPersonalizada {
  id        Int      @id @default(autoincrement())
  usuarioId String   @db.VarChar(36)
  nome      String   @db.VarChar(100)
  descricao String?  @db.Text
  criadoEm  DateTime @default(now())

  usuario Usuario                  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  itens   ItemListaPersonalizada[]
}

model ItemListaPersonalizada {
  id                   Int      @id @default(autoincrement())
  listaPersonalizadaId Int
  tmdbMovieId          Int
  titulo               String   @db.VarChar(255)
  posterPath           String?  @db.VarChar(255)
  criadoEm             DateTime @default(now())

  lista ListaPersonalizada @relation(fields: [listaPersonalizadaId], references: [id], onDelete: Cascade)

  @@unique([listaPersonalizadaId, tmdbMovieId])
}